# ══════════════════════════════════════════════════════════════
#  BreadBot v82 — ENV (copy the lines you need into Render env)
#
#  RULE: empty slot = skipped. The bot works with whatever is there.
#  ──────────────────────────────────────────────────────────────
#  ── THE AI POOL — paste any provider key into a numbered slot ──
#  The provider behind each key is AUTO-DETECTED from its shape:
#      sk-or-v1-…   → OpenRouter
#      sk-rewind-… → Rewind (checked BEFORE sk-)
#      sk-…         → OpenAI
#      anything else → Rewind (your current working endpoint)
#  HOW THE WORK SPLITS: every task goes to the NEXT healthy
#  provider (round-robin). 1 working API = it does everything.
#  5 working APIs = tasks split 5 ways. A provider that fails
#  twice goes on cooldown (5→30 min) and auto-revives when it
#  answers again — add/replace keys anytime.
# ══════════════════════════════════════════════════════════════

PORT=10000

# You = the one admin of BOTH bots (your own WhatsApp number)
ADMIN_PHONE=

# ── v82 MY LINKS — YOUR image sites, tried FIRST on every search ──
MYLINKS=

# ── v82 SESSION BACKUP — NEVER re-scan QRs after a deploy again ──
# Render's free disk is wiped on every deploy. Fix, ONE time:
#   1. deploy v82, scan QR (BOT phone)
#   2. panel → 💾 Session Backup → Copy GROUPS blob → paste into
#      Render env SESSION_B64_GROUPS
#   3. redeploy once — from now on every boot auto-restores. No QR.

# Your scraper deployment (the bot sends MYLINKS to it automatically)
SCRAPER=https://intelligent-scraper.onrender.com

# ── AI POOL SLOTS — paste keys below, leave empty = unused ──
# Slot 1: Rewind (WORKS — verified)
API_1=
# Slot 2: Rewind backup
API_2=
# Slot 3: Rewind backup 5
API_3=
# Slot 4: Rewind backup 3
API_4=
# Slot 5: Rewind backup 4
API_5=
# Slot 6: (empty — add another key here)
API_6=
API_7=
API_8=

# Optional per-slot overrides (only if auto-detect needs help):
#API_1_NAME=
#API_1_URL=
#API_1_MODEL=

# Legacy named keys still work too (they join the same pool):
REWIND_KEY=
REWIND_MODEL=rewind-uncensored
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

# Main group auto-set from this invite link once QR 1 connects
ADMIN_GROUP_LINK=

# ── v82: AI auto-chat for the admin — DEFAULT OFF ──
STUDY_BUDDY=false

# ── v82: AI PERSONA (the girl who answers DMs) ──
AI_NAME=
AI_FULL_NAME=
AI_BIO=

# ── v82: LOGS — web panel ONLY (nothing goes to WhatsApp) ──
LOG_TO_ADMIN=false

# ══════════════════════════════════════════════════════════════
#  v82 MULTI-PLATFORM AUTOMATION — Facebook, YouTube, Twitter, TikTok
#  Each platform is independent: separate browser, data, schedule.
#  Chrome/Chromium is installed via postinstall script.
#  If Chrome is NOT found, the platform degrades gracefully (no crash).
# ══════════════════════════════════════════════════════════════

# ── v84.5 WORKED EXAMPLE — this is what a FILLED-IN block looks like ──
# (fake values — put YOUR real login on each platform)
#   FB_EMAIL=abby.lukwa@gmail.com
#   FB_PASSWORD=MyStr0ngPass!
#   YOUTUBE_EMAIL=abby.lukwa@gmail.com
#   YOUTUBE_PASSWORD=AnotherPass123
#   TWITTER_USERNAME=abbylukwa        ← handle WITHOUT the @
#   TWITTER_PASSWORD=TwPass456
#   TIKTOK_USERNAME=abbylukwa
#   TIKTOK_PASSWORD=TkPass789
# HOW TO SET ON RENDER: Dashboard → your service → Environment →
# "Add Environment Variable" → Key = FB_EMAIL, Value = your email, etc.
# THEN: redeploy once → open the panel → "🔗 Platform Connections"
# card → press 🔌 Connect per platform. First success saves cookies
# (data/<platform>/cookies.json) and every boot after auto-reconnects.

# ── Facebook ──
FB_EMAIL=
FB_PASSWORD=

# ── YouTube (browser automation — unofficial, no API key needed) ──
YOUTUBE_EMAIL=
YOUTUBE_PASSWORD=

# ── Twitter/X ──
TWITTER_USERNAME=
TWITTER_PASSWORD=

# ── TikTok ──
TIKTOK_USERNAME=
TIKTOK_PASSWORD=



# ══════════════════════════════════════════════════════════════
#  v84.5.2 CAPTCHA BYPASS — two ways to beat the login walls
# ══════════════════════════════════════════════════════════════
#  Walls happen because a server IP (Render) looks like a bot.
#  TWO workarounds — use either or both:
#
#  ① COOKIE PASTE (free, manual ONCE): log into each platform in
#     your OWN browser, install the EditThisCookie/cookie-editor
#     extension, Export (JSON), paste into the panel's
#     "🍪 Cookie Bypass" card → Save cookies → press Connect.
#     No CAPTCHA ever again (cookies auto-load every boot).
#
#  ② RESIDENTIAL PROXY (full-auto, ~$3/mo): a home-IP proxy makes
#     the login look like it comes from a real house, not a
#     datacenter — walls usually disappear. Paste your proxy URL
#     below (works with IPRoyal / Bright Data / Smartproxy etc.).
#     Format: http://user:pass@proxy-host:port
#
#PROXY_URL=                 # global — all platforms use it
#TWITTER_PROXY=             # per-platform override (wins over PROXY_URL)
#YOUTUBE_PROXY=
#FACEBOOK_PROXY=
#TIKTOK_PROXY=
